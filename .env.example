# Digital Product Factory - Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git!

# ===========================================
# GUMROAD API (Required for publishing)
# Get from: https://app.gumroad.com/settings/applications
# Create a new application -> Access Token
# ===========================================
GUMROAD_ACCESS_TOKEN=your_access_token_here
GUMROAD_APPLICATION_ID=your_application_id_here

# ===========================================
# CLOUDFLARE WORKERS AI (Free tier: 100k req/day)
# Get from: https://dash.cloudflare.com/profile/api-tokens
# Create token with "Workers AI" permissions
# Account ID from: https://dash.cloudflare.com/ (right sidebar)
# ===========================================
CF_ACCOUNT_ID=your_account_id_here
CF_API_TOKEN=your_api_token_here

# ===========================================
# OLLAMA LOCAL (Fallback - optional)
# Install: https://ollama.com/
# Run: ollama serve
# Pull models: ollama pull llama3:8b && ollama pull mistral:7b && ollama pull codellama:7b
# ===========================================
# OLLAMA_HOST=http://localhost:11434

# ===========================================
# DISCORD/SLACK/TELEGRAM WEBHOOK (Optional - for notifications)
# ===========================================
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# ===========================================
# FACTORY SETTINGS (Optional - override config.yaml)
# ===========================================
# DPF_CONFIG_PATH=config/settings.yaml
# FACTORY_DRY_RUN=false
# FACTORY_PRODUCTS_PER_RUN=3
# FACTORY_RUNS_PER_DAY=2